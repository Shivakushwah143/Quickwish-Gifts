# Copy to .env for local development, or set these in the hosting dashboard.
# Never commit real values.

# --- Runtime -----------------------------------------------------------------
# Most hosts inject PORT; only set it for containers/VM hosts.
PORT=5000
NODE_ENV=production

# --- Database ----------------------------------------------------------------
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/QuickWish

# --- Auth --------------------------------------------------------------------
# JWT signing secret. At least 32 random characters, e.g. `openssl rand -hex 32`.
SECRET=<random-32+-character-secret>
# Optional: enables POST /api/v1/admin/signup only when explicitly set.
# ADMIN_BOOTSTRAP_KEY=

# --- Direct UPI payments (required at startup) -------------------------------
QUICKWISH_UPI_ID=<upi-vpa>
QUICKWISH_UPI_NAME=QuickWish

# --- Connector API (ChatGPT product connector) -------------------------------
# JSON array of SHA-256 hashes of the connector keys. The plaintext key is shown
# once to whoever creates it and never stored here.
# Generate a key:  KEY=$(openssl rand -hex 32); printf %s "$KEY" | sha256sum
CONNECTOR_API_KEYS=[{"id":"chatgpt","sha256":"<64 hex chars>","scopes":["products:read","products:write"]}]
# Local development only (plaintext, grants both scopes):
# CONNECTOR_API_KEY=

# --- MCP Auth0 resource server (separate from connector/customer auth) --------
# Supply all four from the Auth0 tenant/API. Issuer ends with a slash.
# AUTH0_DOMAIN=your-tenant.region.auth0.com
# AUTH0_ISSUER=https://your-tenant.region.auth0.com/
# AUTH0_AUDIENCE=https://api.quickwish.shop/mcp
# AUTH0_JWKS_URI=https://your-tenant.region.auth0.com/.well-known/jwks.json

# --- CORS --------------------------------------------------------------------
# Extra browser origins allowed to call this API, comma separated. The
# production storefront and localhost are always allowed.
# CORS_ALLOWED_ORIGINS=

# --- Image uploads (Cloudinary) ----------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional integrations ---------------------------------------------------
# GROQ_API_KEY=
# GROQ_MODEL=
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=
# CLERK_SECRET_KEY=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=
# WHATSAPP_GRAPH_BASE_URL=

# Copy to .env.local for local development. NEXT_PUBLIC_* values are inlined at
# build time, so changing this requires a redeploy on Vercel.

# Local development
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Production (Vercel) — the API is a separate origin, not proxied through Next.js
# NEXT_PUBLIC_API_URL=https://api.quickwish.shop/api/v1

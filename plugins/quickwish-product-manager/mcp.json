{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "quickwish-products": {
      "type": "streamable-http",
      "url": "https://api.quickwish.shop/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "products:read",
              "products:write"
            ]
          }
        }
      }
    }
  }
}
